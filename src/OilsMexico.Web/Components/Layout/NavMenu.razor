@code {
    // Definimos la variable como un string normal y la inicializamos vacía para evitar advertencias
    private string GrupoAbierto { get; set; } = "ventas";

    protected override void OnParametersSet() => RolActual = Sesion.Sesion?.Rol ?? "";
    private string RolActual { get; set; } = "";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ActualizarGrupoPorUrl();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first || Sesion.Autenticado) return;
        try
        {
            if (await Sesion.RestaurarAsync()) StateHasChanged();
            else Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (InvalidOperationException)
        {
            // JS interop aún no disponible: reintentar en el siguiente render del circuito.
            try { StateHasChanged(); } catch { }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try { ActualizarGrupoPorUrl(); } catch { }
        // Navegación SPA: puede llegar desde prerender sin sincronización; ir siempre por el dispatcher.
        try { InvokeAsync(StateHasChanged); } catch { }
    }

    private void ActualizarGrupoPorUrl()
    {
        var url = Nav.ToBaseRelativePath(Nav.Uri).ToLower();
        RolActual = Sesion.Sesion?.Rol ?? "";

        if (string.IsNullOrEmpty(url) || url.StartsWith("login"))
        {
            GrupoAbierto = "general";
        }
        else if (url.StartsWith("ventas-pos") || url.StartsWith("facturacion") || 
                 url.StartsWith("historial-ventas") || url.StartsWith("notas-credito") || 
                 url.StartsWith("complementos-pago") || url.StartsWith("corte-caja") ||
                 url.StartsWith("metas"))
        {
            GrupoAbierto = "ventas";
        }
        else if (url.StartsWith("ventas-gestion") || url.StartsWith("estado-cuentas"))
        {
            GrupoAbierto = "gestion";
        }
        else if (url.StartsWith("productos") || url.StartsWith("almacen") || 
                 url.StartsWith("viscosidad") || url.StartsWith("compras"))
        {
            GrupoAbierto = "almacen";
        }
        else if (url.StartsWith("clientes") || url.StartsWith("proveedores"))
        {
            GrupoAbierto = "contactos";
        }
        else if (url.StartsWith("sepomex") || url.StartsWith("sucursal") || url.StartsWith("usuarios") || url.StartsWith("configuracion"))
        {
            GrupoAbierto = "config";
        }
    }

    private void Alternar(string grupo)
    {
        // En lugar de usar null, si el grupo ya está abierto lo asignamos como string vacío ""
        GrupoAbierto = GrupoAbierto == grupo ? string.Empty : grupo;
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
