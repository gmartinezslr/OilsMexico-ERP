@rendermode InteractiveServer
@inject OilsMexico.Application.Interfaces.IAvisos Avisos
@implements IDisposable

<div class="aviso-campana">
    <button type="button" class="campana-btn" title="Avisos" @onclick="Alternar" aria-expanded="@abierto">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" />
        </svg>
        @if (Avisos.NoLeidos > 0)
        {
            <span class="campana-badge">@(Avisos.NoLeidos > 9 ? "9+" : Avisos.NoLeidos.ToString())</span>
        }
    </button>
    @if (abierto)
    {
        <div class="campana-panel shadow">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>Avisos</strong>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="Leer">Marcar leídos</button>
                    <button type="button" class="btn btn-sm btn-link p-0 text-danger" @onclick="Borrar">Limpiar</button>
                </div>
            </div>
            @if (Avisos.Lista.Count == 0)
            {
                <div class="text-muted small">Sin avisos en esta sesión. Aquí verás ventas cobradas, códigos no encontrados y clientes creados.</div>
            }
            @foreach (var a in Avisos.Lista)
            {
                <div class="campana-item campana-@a.Tipo @(a.Leido ? "" : "no-leido")">
                    <div class="fw-semibold small">@a.Titulo</div>
                    @if (!string.IsNullOrEmpty(a.Detalle))
                    {
                        <div class="small text-muted">@a.Detalle</div>
                    }
                    <div class="campana-fecha">@a.FechaUtc.ToLocalTime().ToString("HH:mm")</div>
                </div>
            }
        </div>
    }
</div>

<style>
.aviso-campana { position: relative; }
.campana-btn { position: relative; background: none; border: 1px solid #dee2e6; border-radius: 50%; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; color: #495057; }
.campana-btn:hover { background: #f1f3f5; }
.campana-badge { position: absolute; top: -6px; right: -6px; background: #dc3545; color: #fff; font-size: .65rem; font-weight: 700; border-radius: 10px; padding: 0 5px; line-height: 16px; min-width: 16px; text-align: center; }
.campana-panel { position: absolute; right: 0; top: 40px; width: 320px; max-height: 380px; overflow-y: auto; background: #fff; border: 1px solid #dee2e6; border-radius: 10px; padding: 12px; z-index: 1050; }
.campana-item { border-left: 3px solid #adb5bd; padding: 6px 8px; margin-bottom: 8px; background: #f8f9fa; border-radius: 0 6px 6px 0; }
.campana-item.no-leido { background: #fff8e1; }
.campana-info { border-color: #0dcaf0; }
.campana-exito { border-color: #198754; }
.campana-aviso { border-color: #ffc107; }
.campana-error { border-color: #dc3545; }
.campana-fecha { font-size: .7rem; color: #868e96; }
</style>

@code {
    private bool abierto;

    protected override void OnInitialized() => Avisos.Cambio += AlCambiar;

    private void AlCambiar()
    {
        try { InvokeAsync(StateHasChanged); } catch { }
    }

    private void Alternar()
    {
        abierto = !abierto;
        if (abierto) Avisos.MarcarLeidos();
    }

    private void Leer() => Avisos.MarcarLeidos();

    private void Borrar() => Avisos.Limpiar();

    public void Dispose() => Avisos.Cambio -= AlCambiar;
}
