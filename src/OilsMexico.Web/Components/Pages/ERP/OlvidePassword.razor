@page "/olvide-mi-contrasena"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OilsMexico.Application.Interfaces.IAuthService Auth
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Recuperar Contraseña | OilsMexico ERP</PageTitle>

<div class="container py-5 min-vh-100 d-flex align-items-center justify-content-center" style="max-width:440px">
    <div class="card shadow w-100 border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-dark text-white text-center py-3">
            <h4 class="mb-0 fw-bold">OilsMexico ERP</h4>
            <small class="text-white-50">Recuperación de Contraseña</small>
        </div>
        <div class="card-body p-4">
            @if (solicitudEnviada)
            {
                <div class="text-center py-2">
                    <div class="mb-3 text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-envelope-check-fill" viewBox="0 0 16 16">
                            <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"/>
                            <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-1.993-1.679a.5.5 0 0 0-.686.172l-1.17 1.95-.547-.547a.5.5 0 0 0-.708.708l.9 0.9a.5.5 0 0 0 .762-.06l1.45-2.42a.5.5 0 0 0-.001-.703"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Solicitud recibida</h5>
                    <div class="alert alert-success border-0 small text-start mb-4" style="line-height:1.5;">
                        @mensajeFeedback
                    </div>
                    <p class="text-muted small mb-4">
                        El enlace permanecerá activo durante <strong>15 minutos</strong>. Si no lo visualizas en tu bandeja de entrada, asegúrate de comprobar tu carpeta de spam.
                    </p>
                    <a href="/login" class="btn btn-outline-primary w-100 py-2 fw-semibold">
                        ← Volver al inicio de sesión
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted small mb-3">
                    Ingresa la dirección de correo electrónico registrada en tu cuenta. Te enviaremos un enlace seguro para que puedas establecer una nueva contraseña.
                </p>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="correoRecuperacion">Correo electrónico</label>
                    <input id="correoRecuperacion"
                           type="email"
                           inputmode="email"
                           autocomplete="email"
                           class="form-control form-control-lg"
                           placeholder="ejemplo@oilsmexico.com"
                           @bind="email"
                           @onkeydown="AlTecla"
                           disabled="@cargando" />
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @error
                    </div>
                }

                <button class="btn btn-primary btn-lg w-100 fw-semibold mb-3"
                        @onclick="EnviarSolicitud"
                        disabled="@cargando">
                    @if (cargando)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Enviando enlace...</span>
                    }
                    else
                    {
                        <span>Enviar enlace de recuperación</span>
                    }
                </button>

                <div class="text-center">
                    <a href="/login" class="text-decoration-none small text-muted">
                        ← Volver al inicio de sesión
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string error = "";
    private string mensajeFeedback = "";
    private bool cargando = false;
    private bool solicitudEnviada = false;

    private async Task AlTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await EnviarSolicitud();
        }
    }

    private async Task EnviarSolicitud()
    {
        if (cargando) return;

        var correoLimpio = email?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(correoLimpio))
        {
            error = "Por favor escribe tu correo electrónico.";
            return;
        }

        cargando = true;
        error = "";
        StateHasChanged();

        try
        {
            var res = await Auth.SolicitarRecuperacionAsync(correoLimpio, Nav.BaseUri);
            mensajeFeedback = res.Mensaje;
            solicitudEnviada = true;
        }
        catch
        {
            // OWASP: respuesta genérica consistente incluso ante fallos imprevistos
            mensajeFeedback = "Si la dirección de correo electrónico está registrada en el sistema, recibirás un enlace de recuperación en breve.";
            solicitudEnviada = true;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
