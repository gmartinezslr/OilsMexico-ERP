@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OilsMexico.Application.Interfaces.IAuthService Auth
@inject OilsMexico.Application.Interfaces.ISesionActual Sesion
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage AlmacenLocal
@using Microsoft.AspNetCore.Components.Web
<style>
    .remember-row { user-select: none; }
    .remember-switch .form-check-input { width: 2.75em; height: 1.5em; cursor: pointer; }
    .remember-switch .form-check-input:focus { border-color: var(--oc-primary, #2563EB); box-shadow: 0 0 0 .18rem rgba(37, 99, 235, .25); }
</style>
<PageTitle>Acceso | OilsMexico ERP</PageTitle>
<div class="container py-5 min-vh-100 d-flex align-items-center" style="max-width:420px">
<div class="card shadow">
<div class="card-header bg-dark text-white text-center"><h4 class="mb-0">OilsMexico ERP</h4><small>Inicia sesión</small></div>
<div class="card-body">
@if(estadoDosFa){
<label class="form-label" for="codigo2fa">Código de dos factores (2FA)</label>
<input id="codigo2fa" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="form-control form-control-lg mb-2" placeholder="000000" @bind="codigo2fa" @onkeydown="AlTecla" />
<p class="text-muted small mb-0">Abre tu aplicación de autenticación (Google Authenticator, Authy, etc.) y escribe el código de 6 dígitos.</p>
}
else if(estadoPasswordExpirada){
<label class="form-label" for="pwdActual">Contraseña actual</label>
<input id="pwdActual" type="password" autocomplete="current-password" class="form-control form-control-lg mb-2" @bind="expActual" />
<label class="form-label" for="pwdNueva">Nueva contraseña</label>
<input id="pwdNueva" type="password" autocomplete="new-password" class="form-control form-control-lg mb-2" @bind="expNueva" placeholder="Mínimo 20 caracteres: MAYÚSCULA, minúscula, número y especial" />
<label class="form-label" for="pwdConfirmar">Confirmar nueva contraseña</label>
<input id="pwdConfirmar" type="password" autocomplete="new-password" class="form-control form-control-lg mb-2" @bind="expConfirmar" @onkeydown="AlTecla" />
}
else{
<label class="form-label" for="usuario">Correo o nombre de usuario</label>
<input id="usuario" autocomplete="username" class="form-control form-control-lg mb-3" placeholder="usuario@empresa.com" @bind="identificador" />
<label class="form-label" for="contrasena">Contraseña</label>
<input id="contrasena" type="password" autocomplete="current-password" class="form-control form-control-lg mb-2"
placeholder="Contraseña" @bind="password" @onkeydown="AlTecla" />
<div class="d-flex justify-content-between align-items-center mb-3 remember-row">
<label class="form-check-label fw-semibold mb-0" for="recordar">Recordar mi usuario</label>
<div class="form-check form-switch m-0 remember-switch">
<input class="form-check-input" type="checkbox" id="recordar" @bind="recordarUsuario" @bind:after="AlCambiarRecordar" />
</div>
</div>
}
@if(!string.IsNullOrEmpty(error)){<div class="alert alert-danger py-1">@error</div>}
<button class="btn btn-primary btn-lg w-100" @onclick="AccionPrincipal" disabled="@cargando">@BotonPrincipal</button>
@if(estadoDosFa || estadoPasswordExpirada){
<button class="btn btn-link w-100 mt-2 text-decoration-none" @onclick="VolverAlLogin" disabled="@cargando">← Volver al inicio de sesión</button>
}
</div></div></div>
@code{
const string ClaveRecordar = "oilsmexico.recordar_usuario";
const string ClaveUsuario = "oilsmexico.usuario";
string identificador=""; string password=""; string error=""; bool cargando=false;
bool recordarUsuario = true;
// Pasos especiales: desafío 2FA y cambio obligatorio de contraseña vencida.
bool estadoDosFa=false; string codigo2fa="";
bool estadoPasswordExpirada=false; int usuarioExpiraId=0;
string expActual="", expNueva="", expConfirmar="";
string BotonPrincipal => cargando ? "Procesando…" : estadoDosFa ? "Verificar código" : estadoPasswordExpirada ? "Cambiar contraseña" : "Entrar";
async Task AlTecla(KeyboardEventArgs e){ if(e.Key=="Enter") await AccionPrincipal(); }
async Task AccionPrincipal(){
if(estadoDosFa) await EjecutarLogin(codigo2fa);
else if(estadoPasswordExpirada) await CambiarPasswordExpirada();
else await EjecutarLogin(null);
}
async Task VolverAlLogin(){
estadoDosFa=false; estadoPasswordExpirada=false; codigo2fa="";
expActual=expNueva=expConfirmar=""; password=""; error="";
}
protected override async Task OnAfterRenderAsync(bool firstRender){
if(!firstRender) return;
try{
var pref = await AlmacenLocal.GetAsync<bool>(ClaveRecordar);
// Sin preferencia guardada: encendido por defecto y campo vacío.
recordarUsuario = !pref.Success || pref.Value;
if(recordarUsuario){
var g = await AlmacenLocal.GetAsync<string>(ClaveUsuario);
if(g.Success && !string.IsNullOrWhiteSpace(g.Value)) identificador = g.Value!;
}
else identificador = "";
}catch{ recordarUsuario = true; }
StateHasChanged();
}
async Task AlCambiarRecordar(){
try{
await AlmacenLocal.SetAsync(ClaveRecordar, recordarUsuario);
// Al apagarlo se borra el usuario guardado para que la próxima vez aparezca limpio.
if(!recordarUsuario) await AlmacenLocal.DeleteAsync(ClaveUsuario);
}catch{ }
}
async Task EjecutarLogin(string? codigo){
if(cargando) return;
cargando=true; error=""; StateHasChanged();
try{
var r=await Auth.LoginAsync(identificador, password, codigo);
var s=r.Sesion;
if(s is null){
 error=r.MensajeError??"No fue posible iniciar sesión.";
 if(r.RequiereDosFa){ estadoDosFa=true; estadoPasswordExpirada=false; codigo2fa=""; }
 else{
  estadoDosFa=false; codigo2fa="";
  estadoPasswordExpirada=r.PasswordExpirada;
  usuarioExpiraId=r.UsuarioId??0; expActual=expNueva=expConfirmar="";
  // Si no es un caso especial se limpia la contraseña para evitar reintentos ciegos.
  if(!r.PasswordExpirada) password="";
 }
}
else{
estadoDosFa=false; estadoPasswordExpirada=false;
var id = identificador.Trim();
try{
await AlmacenLocal.SetAsync(ClaveRecordar, recordarUsuario);
if(recordarUsuario && id.Length > 0) await AlmacenLocal.SetAsync(ClaveUsuario, id);
else await AlmacenLocal.DeleteAsync(ClaveUsuario);
}catch{ }
await Sesion.IniciarAsync(s);
Nav.NavigateTo("/", forceLoad: true);
return;
}
}catch(Exception ex){ error="Error: "+ex.Message; }
cargando=false; StateHasChanged();
}
// Cambio obligatorio de contraseña vencida (antes de entrar): valida la actual contra la BD
// y aplica la política configurada por el administrador (complejidad, historial y vigencia).
async Task CambiarPasswordExpirada(){
if(cargando) return;
if(string.IsNullOrWhiteSpace(expActual)||string.IsNullOrWhiteSpace(expNueva)){ error="Escribe tu contraseña actual y la nueva."; return; }
if(expNueva!=expConfirmar){ error="La confirmación no coincide con la nueva contraseña."; return; }
cargando=true; error=""; StateHasChanged();
try{
var r=await Auth.CambiarContraseñaAsync(usuarioExpiraId, expActual, new(expNueva, expConfirmar));
if(!r.Exitoso){ error=r.Mensaje??"No se pudo cambiar la contraseña."; }
else{
 estadoPasswordExpirada=false; expActual=expNueva=expConfirmar="";
 // Reintenta el acceso con la contraseña nueva.
 await EjecutarLogin(null); return;
}
}catch(Exception ex){ error="Error: "+ex.Message; }
cargando=false; StateHasChanged();
}
}
