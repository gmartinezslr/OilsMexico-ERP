@page "/estado-cuentas"
@using OilsMexico.Application.Interfaces
@using OilsMexico.Application.DTOs
@inject IEstadoCuentasService EstadoCuentas
@inject ISucursalContext SucCtx
@inject ISesionActual Sesion
@{
    var saldoInsoluto = _estados is null ? 0m : _estados.Sum(x => x.SaldoPendiente);
}
<PageTitle>Cuentas por Cobrar | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <h3 class="fw-bold mb-0">Cuentas por Cobrar <span class="badge bg-secondary">Saldo insoluto @saldoInsoluto:0.00</span></h3>
        <span class="text-muted small">@(Sesion.Sesion?.Nombre ?? "") (@(Sesion.Sesion?.Rol ?? ""))</span>
    </div>

    @if (_cargando)
    {
        <div class="alert alert-light">Cargando…</div>
    }
    else if (_estados is null || _estados.Count == 0)
    {
        <div class="alert alert-success">No hay saldos insolutos en esta sucursal.</div>
    }
    else
    {
        <div class="card shadow-sm"><div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th>Cliente</th><th>RFC</th><th>Facturas abiertas</th><th class="text-end">Total abiertas</th><th class="text-end">Pagos aplicados</th><th class="text-end">Saldo pendiente</th></tr></thead>
                <tbody>
                @foreach (var e in _estados!)
                {
                    var cls = e.SaldoPendiente > 0m ? "table-danger" : "table-success";
                    <tr class="@cls">
                        <td>@e.Nombre</td>
                        <td>@e.Rfc</td>
                        <td>@e.FacturasAbiertas.Count</td>
                        <td class="text-end">@e.TotalFacturas:0.00</td>
                        <td class="text-end">@e.TotalPagosAplicados:0.00</td>
                        <td class="text-end fw-bold">@e.SaldoPendiente:0.00</td>
                    </tr>
                }
                </tbody>
            </table>
        </div></div>
    }
</div>
