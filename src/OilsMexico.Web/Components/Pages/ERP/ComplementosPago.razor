@page "/complementos-pago"
@rendermode InteractiveServer
@inject OilsMexico.Application.Interfaces.IComplementoPagoService Rep
@inject OilsMexico.Application.Interfaces.ICatalogosSatService Sat
@inject OilsMexico.Application.Interfaces.ISucursalContext SucCtx
@inject OilsMexico.Application.Interfaces.ISesionActual Sesion
@inject NavigationManager Nav
@using OilsMexico.Application.DTOs
<PageTitle>Complementos de pago | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Complementos de pago <span class="badge bg-secondary">Suc @SucCtx.SucursalId</span></h3>
        <span class="text-muted small">@(Sesion.Sesion?.Nombre ?? "") (@(Sesion.Sesion?.Rol ?? ""))</span>
    </div>
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
    }
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">PPD por liquidar (@pendientes.Count)</div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" style="max-height:55vh;overflow-y:auto">
                    @foreach (var p in pendientes)
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between">
                                <strong>@p.FolioInterno</strong>
                                <span class="badge bg-warning text-dark">Saldo $@p.Saldo.ToString("N2")</span>
                            </div>
                            <small class="text-muted d-block">@p.Cliente · Total $@p.Total.ToString("N2")</small>
                            @if (cobrarId == p.FacturaId)
                            {
                                <div class="row g-1 mt-2">
                                    <div class="col-4"><input type="number" step="0.01" class="form-control form-control-sm" @bind="monto" /></div>
                                    <div class="col-4"><select class="form-select form-select-sm" @bind="forma">
                                        @foreach (var kv in formas) { <option value="@kv.Key">@kv.Value</option> }
                                    </select></div>
                                    <div class="col-4"><input class="form-control form-control-sm" placeholder="Referencia" @bind="referencia" /></div>
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button class="btn btn-sm btn-success flex-fill" disabled="@cargando" @onclick="() => ConfirmarCobro(p)">Cobrar y timbrar REP</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => cobrarId = null">Cerrar</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success mt-1" @onclick="() => EmpezarCobro(p)">Registrar cobro</button>
                            }
                        </div>
                    }
                    @if (pendientes.Count == 0)
                    {
                        <div class="list-group-item text-muted text-center py-4">Sin saldos PPD.</div>
                    }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">REPs timbrados (@reps.Count) · Tipo P · Uso CP01</div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:55vh;overflow-y:auto">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-dark position-sticky top-0"><tr><th>Fecha</th><th>Folio</th><th>Cliente</th><th class="text-end">Monto</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var r in reps)
                            {
                                <tr>
                                    <td class="small">@r.FechaEmision.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                    <td><strong>@r.FolioInterno</strong></td>
                                    <td class="small">@r.Cliente</td>
                                    <td class="text-end">$@r.Total.ToString("N2")</td>
                                    <td><span class="badge bg-success">@r.Estado</span></td>
                                    <td class="text-nowrap">
                                        @if (r.TieneXml) { <a class="btn btn-sm btn-success" href="/api/reps/@r.RepId/xml">XML</a> }
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(r.RepId)">Ver</button>
                                    </td>
                                </tr>
                                @if (detalle?.RepId == r.RepId)
                                {
                                    <tr><td colspan="6"><small class="text-muted">UUID <code>@detalle.UuidSat</code></small>
                                    @foreach (var d in detalle.Documentos)
                                    {
                                        <div class="small">@d.FolioFactura · parc #@d.NumParcialidad · ant $@d.ImpSaldoAnt.ToString("N2") · pagado $@d.ImpPagado.ToString("N2") · insoluto $@d.ImpSaldoInsoluto.ToString("N2")</div>
                                    }
                                    </td></tr>
                                }
                            }
                            @if (reps.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">Aún no hay REPs.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
