@page "/metas"
@rendermode InteractiveServer
@* Las dependencias se inyectan en el code-behind (Metas.razor.cs), no aquí. *@
<PageTitle>Metas y comisiones | OilsMexico ERP</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="fw-bold mb-0">Metas y comisiones</h3>
        <div class="d-flex align-items-center gap-2">
            @if (EsAdmin)
            {
                <select class="form-select form-select-sm w-auto" value="@(vendSel?.Id ?? 0)" @onchange="CambioVendedor">
                    @foreach (var v in vendedores)
                    {
                        <option value="@v.Id">@v.Nombre (@v.Rol)</option>
                    }
                </select>
            }
            else
            {
                <span class="badge text-bg-info">Vista de vendedor (sólo lectura)</span>
            }
            <select class="form-select form-select-sm w-auto" value="@anio" @onchange="CambioAnio">
                @foreach (var a in Anios)
                {
                    <option value="@a">@a</option>
                }
            </select>
            <select class="form-select form-select-sm w-auto" value="@mes" @onchange="CambioMes">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m">@MesNombre(m)</option>
                }
            </select>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Refrescar">Actualizar</button>
        </div>
    </div>

    @if (calc is not null)
    {
        <!-- ============ AVANCE EN VIVO (Pantalla B del documento, integrada) ============ -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-1">Avance de @calc.Vendedor · @Periodo</h5>
                        <small class="text-muted">Sobre cobranza efectiva del periodo (dinero sin IVA).</small>
                    </div>
                    <div class="text-end">
                        <div class="fs-4 fw-bold @(calc.CumplioMeta ? "text-success" : "text-danger")">
                            @calc.ComisionFinal.ToString("C")
                        </div>
                        <small class="text-muted">
                            comisión @(calc.CumplioMeta ? "con bono" : "sin bono")
                            @if (calc.AplicoPagoMinimo)
                            {
                                <span class="badge text-bg-warning">pago mínimo aplicado</span>
                            }
                        </small>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    @if (calc.MetaDinero is not null)
                    {
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">Meta de dinero</span>
                                <span>@calc.DineroReal.ToString("C") de @calc.MetaDinero?.ToString("C") (@calc.PctDinero.ToString("N1")%)</span>
                            </div>
                            <div class="progress" style="height:18px">
                                <div class="progress-bar @(calc.PctDinero >= 100 ? "bg-success" : "bg-primary")"
                                     role="progressbar" style="width:@Ancho(calc.PctDinero)%">
                                    @calc.PctDinero.ToString("N0")%
                                </div>
                            </div>
                        </div>
                    }
                    @if (calc.MetaLitros is not null)
                    {
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">Meta de volumen</span>
                                <span>@calc.LitrosReales.ToString("N2") de @calc.MetaLitros?.ToString("N2") L (@calc.PctLitros.ToString("N1")%)</span>
                            </div>
                            <div class="progress" style="height:18px">
                                <div class="progress-bar @(calc.PctLitros >= 100 ? "bg-success" : "bg-primary")"
                                     role="progressbar" style="width:@Ancho(calc.PctLitros)%">
                                    @calc.PctLitros.ToString("N0")%
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!calc.TieneCuota)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2">
                        <strong>Sin cuota configurada</strong> para este periodo: se paga el % base y no hay bono posible.
                    </div>
                }

                <div class="row g-2 mt-3 small">
                    <div class="col-auto"><span class="text-muted">Cobrado bruto (con IVA):</span> <strong>@calc.CobradoBruto.ToString("C")</strong></div>
                    <div class="col-auto"><span class="text-muted">Base sin IVA:</span> <strong>@calc.DineroReal.ToString("C")</strong></div>
                    <div class="col-auto"><span class="text-muted">Litros:</span> <strong>@calc.LitrosReales.ToString("N2") L</strong></div>
                    <div class="col-auto"><span class="text-muted">Facturas cobradas:</span> <strong>@calc.FacturasCobradas</strong></div>
                </div>
                <div class="small text-muted mt-1"><em>@calc.DetalleEvaluacion</em></div>

                @if (calc.ProductosSinTabulador.Count > 0)
                {
                    <div class="alert alert-warning mt-2 mb-0 py-2 small">
                        <strong>Productos cobrados sin % de comisión configurado</strong> (no generan comisión):
                        @string.Join(", ", calc.ProductosSinTabulador).
                    </div>
                }


    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success") py-2">@msg</div>
    }

                <!-- ============ DESGLOSE POR PRODUCTO (con el % aplicado) ============ -->
                @if (calc.Productos.Count > 0)
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Cobrado sin IVA</th>
                                    <th class="text-end">Litros</th>
                                    <th class="text-center">% base</th>
                                    <th class="text-center">% bono</th>
                                    <th class="text-end">Com. base</th>
                                    <th class="text-end">Com. bono</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in calc.Productos)
                                {
                                    <tr>
                                        <td>@p.Producto <small class="text-muted">(@p.Unidad)</small></td>
                                        <td class="text-end">@p.NetoSinIva.ToString("C")</td>
                                        <td class="text-end">@p.Litros.ToString("N2")</td>
                                        <td class="text-center">@p.PorcBase.ToString("N2")%</td>
                                        <td class="text-center text-success fw-semibold">@p.PorcBono.ToString("N2")%</td>
                                        <td class="text-end text-muted">@p.ComisionBase.ToString("C")</td>
                                        <td class="text-end">@p.ComisionBono.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr class="fw-bold">
                                    <td>Total</td>
                                    <td class="text-end">@calc.DineroReal.ToString("C")</td>
                                    <td class="text-end">@calc.LitrosReales.ToString("N2")</td>
                                    <td colspan="2"></td>
                                    <td class="text-end text-muted">@calc.ComisionBase.ToString("C")</td>
                                    <td class="text-end">@calc.ComisionBono.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ============ CAPTURA DE LA META (sólo Admin) ============ -->
    @if (EsAdmin)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">
                Meta de @(vendSel?.Nombre ?? "—") · @Periodo
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chkDinero"
                                   checked="@(chkDinero == "true")"
                                   @onchange="CambioChkDinero" />
                            <label class="form-check-label fw-semibold" for="chkDinero">Meta de dinero</label>
                        </div>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0" class="form-control" placeholder="0.00"
                                   disabled="@(chkDinero != "true")" @bind="txtMetaDinero" />
                        </div>
                        <div class="form-text">Sobre cobranza sin IVA.</div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="chkLitros"
                                   checked="@(chkLitros == "true")"
                                   @onchange="CambioChkLitros" />
                            <label class="form-check-label fw-semibold" for="chkLitros">Meta de volumen (L)</label>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.01" min="0" class="form-control" placeholder="0.00"
                                   disabled="@(chkLitros != "true")" @bind="txtMetaLitros" />
                            <span class="input-group-text">L</span>
                        </div>
                        <div class="form-text">Litros equivalentes cobrados.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Regla de liberación</label>
                        <select class="form-select form-select-sm" @bind="operador">
                            <option value="@OperadorLogico.SoloDinero">Sólo dinero</option>
                            <option value="@OperadorLogico.SoloVolumen">Sólo volumen</option>
                            <option value="@OperadorLogico.Y">Dinero Y volumen</option>
                            <option value="@OperadorLogico.O">Dinero O volumen</option>
                        </select>
                        <div class="form-text">Qué metas debe cumplir para llevarse el bono.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Si NO cumple la meta</label>
                        <select class="form-select form-select-sm" @bind="accion">
                            <option value="@AccionIncumplimiento.CeroComision">Cero comisión</option>
                            <option value="@AccionIncumplimiento.PagoMinimo">Pago mínimo garantizado</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Monto del pago mínimo</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">$</span>
                            <input type="number" step="0.01" min="0" class="form-control" placeholder="0.00"
                                   disabled="@(accion != AccionIncumplimiento.PagoMinimo)" @bind="txtPagoMinimo" />
                        </div>
                        <div class="form-text">Se paga el mayor entre la comisión base y este monto.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small mb-1">Notas</label>
                        <input type="text" class="form-control form-control-sm" maxlength="300"
                               placeholder="Opcional" @bind="txtNotas" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary btn-sm" disabled="@guardando" @onclick="Guardar">
                        @(guardando ? "Guardando…" : "Guardar meta")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" disabled="@guardando" @onclick="RestaurarForm">
                        Descartar cambios
                    </button>
                    @if (cuotaId is not null)
                    {
                        <button class="btn btn-outline-danger btn-sm" disabled="@guardando" @onclick="EliminarCuota">
                            Eliminar meta
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

