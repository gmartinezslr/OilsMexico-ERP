@page "/ordenes-vente/detalle/{id}"
@rendermode InteractiveServer
@using OilsMexico.Application.DTOs
@using OilsMexico.Domain.Enums
<PageTitle>Detalle de orden de venta | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Detalle de orden de venta</h5>
        </div>
        <div class="card-body">
            @if (cargando)
            {
                <div class="alert alert-light">Cargando…</div>
            }
            else if (!string.IsNullOrEmpty(msg))
            {
                <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
            }
            else if (orden is null)
            {
                <div class="alert alert-warning">Orden no encontrada. <a href="/ordenes-vente">Volver al listado</a></div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <dl class="row">
                            <dt class="col-sm-4 fw-semibold">Folio</dt>
                            <dd class="col-sm-8"><strong>@orden.FolioInterno</strong></dd>
                            <dt class="col-sm-4 fw-semibold">Fecha</dt>
                            <dd class="col-sm-8">@orden.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                            <dt class="col-sm-4 fw-semibold">Cliente</dt>
                            <dd class="col-sm-8">@orden.Cliente</dd>
                            <dt class="col-sm-4 fw-semibold">Vendedor</dt>
                            <dd class="col-sm-8">@orden.Vendedor ?? "—"</dd>
                            <dt class="col-sm-4 fw-semibold">Origen</dt>
                            <dd class="col-sm-8">@orden.CotizacionId switch
                            {
                                > 0 => "Derivada de cotización #" + orden.CotizacionId,
                                _ => "Manual"
                            }</dd>
                            <dt class="col-sm-4 fw-semibold">Estado</dt>
                            <dd class="col-sm-8"><span class="badge bg-@(ClaseEstado(orden.Estado))">@orden.Estado</span></dd>
                            <dt class="col-sm-4 fw-semibold">Total</dt>
                            <dd class="col-sm-8 text-danger">$@orden.Total.ToString("N2")</dd>
                        </dl>
                    </div>
                    <div class="col-md-8">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="bg-secondary">
                                        <th style="width:34%">Producto</th>
                                        <th style="width:14%" class="text-end">Cant.</th>
                                        <th style="width:22%" class="text-end">Precio</th>
                                        <th style="width:16%" class="text-end">Desc.</th>
                                        <th style="width:14%" class="text-end">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in orden.Detalles)
                                    {
                                        <tr class="align-middle">
                                            <td>@d.Sku &nbsp;-&nbsp; @d.Nombre</td>
                                            <td class="text-end">@d.Cantidad</td>
                                            <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                                            <td class="text-end">$@d.Descuento.ToString("N2")</td>
                                            <td class="text-end">$@d.Importe.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (orden.Detalles.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted">Sin renglones.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            @if (Accion == "confirmar")
            {
                <hr />
                <h6 class="mt-3">Confirmar orden de venta</h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label small">Vendedor</label>
                        <select class="form-select" @bind="vendedorConf">
                            @foreach (var v in vendedores)
                            {
                                <option value="@v.Id" selected="@(v.Id == vendedorConf)">@v.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-success btn-sm" @onclick="ConfirmarConfirmacion" disabled="@confirmando">
                            @confirmando ? "Confirmando…" : "Confirmar orden"
                        </button>
                    </div>
                </div>
            }
            else if (Accion == "cancelar")
            {
                <hr />
                <h6 class="mt-3">Cancelar orden de venta</h6>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small">Motivo</label>
                        <input class="form-control" @bind="motivoCancel" placeholder="Motivo de cancelación" />
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-danger btn-sm" @onclick="ConfirmarCancelacion" disabled="@cancelando">
                            @cancelando ? "Cancelando…" : "Confirmar cancelación"
                        </button>
                    </div>
                </div>
            }
            else if (Accion == "facturar")
            {
                <hr />
                <h6 class="mt-3">Facturar orden de venta</h6>
                @if (orden is null || orden.Estado is not EstadoOrdenVenta.Confirmada || orden.FacturaId is not null)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        Solo se pueden facturar órdenes Confirmadas sin factura.
                        <a href="/ordenes-vente/detalle/@Id">Volver al detalle</a>
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label small">Forma de pago</label>
                            <select class="form-select" @bind="formaPago">
                                @foreach (var f in catalogos.FormasPago)
                                {
                                    <option value="@f.Key">@f.Key – @f.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Método de pago</label>
                            <select class="form-select" @bind="metodoPago">
                                @foreach (var m in catalogos.MetodosPago)
                                {
                                    <option value="@m.Key">@m.Key – @m.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Uso CFDI</label>
                            <select class="form-select" @bind="usoCfdi">
                                @foreach (var u in catalogos.UsosCfdi)
                                {
                                    <option value="@u.Key">@u.Key – @u.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkTimbrar" @bind="requiereFactura" />
                                <label class="form-check-label small" for="chkTimbrar">Timbrar ahora</label>
                            </div>
                            <button class="btn btn-success btn-sm" @onclick="ConfirmarFacturacion" disabled="@facturando">
                                @(facturando ? "Facturando…" : "Generar venta")
                            </button>
                        </div>
                    </div>
                    <div class="form-text">
                        Se conservan los precios de compromiso de la orden (@orden.Total.ToString("N2")) y se
                        descuentará el stock de la sucursal.
                    </div>
                }
            }
            else if (Accion == "suspender")
            {
                <hr />
                <h6 class="mt-3">Suspender orden de venta</h6>
                @if (orden is null || orden.Estado is not EstadoOrdenVenta.Confirmada || orden.FacturaId is not null)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        Solo se pueden suspender órdenes Confirmadas sin factura.
                        <a href="/ordenes-vente/detalle/@Id">Volver al detalle</a>
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small">Motivo (opcional)</label>
                            <input class="form-control" @bind="motivoSusp" placeholder="Motivo de la suspensión" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button class="btn btn-warning btn-sm" @onclick="ConfirmarSuspension" disabled="@suspendiendo">
                                @(suspendiendo ? "Suspendiendo…" : "Suspender orden")
                            </button>
                        </div>
                    </div>
                    <div class="form-text">
                        La orden queda bloqueada (no se puede facturar) hasta que se reanude; los precios de
                        compromiso no cambian.
                    </div>
                }
            }
            else if (Accion == "reanudar")
            {
                <hr />
                <h6 class="mt-3">Reanudar orden de venta</h6>
                @if (orden is null || orden.Estado is not EstadoOrdenVenta.Suspendida)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        Solo se pueden reanudar órdenes en estado Suspendida.
                        <a href="/ordenes-vente/detalle/@Id">Volver al detalle</a>
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small">Motivo (opcional)</label>
                            <input class="form-control" @bind="motivoSusp" placeholder="Motivo de la reanudación" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button class="btn btn-success btn-sm" @onclick="ConfirmarReanudacion" disabled="@reanudando">
                                @(reanudando ? "Reanudando…" : "Reanudar orden")
                            </button>
                        </div>
                    </div>
                    <div class="form-text">
                        La orden regresa a Confirmada con sus precios de compromiso intactos y vuelve a ser facturable.
                    </div>
                }
            }
            else if (orden is not null)
            {
                <div class="d-flex gap-2 mt-3">
                    @if (orden.Estado is EstadoOrdenVenta.Borrador)
                    {
                        <button class="btn btn-outline-success btn-sm" style="width:140px" @onclick="AbrirConfirmar">Confirmar</button>
                    }
                    @if (orden.Estado is EstadoOrdenVenta.Confirmada && orden.FacturaId is null)
                    {
                        <button class="btn btn-success btn-sm" style="width:180px" @onclick="AbrirFacturar">Facturar / Generar venta</button>
                        <button class="btn btn-outline-warning btn-sm" style="width:140px" @onclick="AbrirSuspender">Suspender</button>
                    }
                    @if (orden.Estado is EstadoOrdenVenta.Suspendida)
                    {
                        <button class="btn btn-outline-success btn-sm" style="width:140px" @onclick="AbrirReanudar">Reanudar</button>
                    }
                    @if (orden.Estado is not EstadoOrdenVenta.Facturada)
                    {
                        <button class="btn btn-outline-danger btn-sm" style="width:140px" @onclick="AbrirCancelar">Cancelar</button>
                    }
                    @if (orden.FacturaId is int facturaId)
                    {
                        <a class="btn btn-outline-primary btn-sm" style="width:170px" href="/facturacion">Ver factura #@facturaId</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

