@page "/recuperar-password"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject OilsMexico.Application.Interfaces.IAuthService Auth
@inject OilsMexico.Application.Interfaces.IPoliticaPassword PoliticaPwd
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Web
@using OilsMexico.Application.DTOs

<PageTitle>Establecer Nueva Contraseña | OilsMexico ERP</PageTitle>

<div class="container py-5 min-vh-100 d-flex align-items-center justify-content-center" style="max-width:480px">
    <div class="card shadow w-100 border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-dark text-white text-center py-3">
            <h4 class="mb-0 fw-bold">OilsMexico ERP</h4>
            <small class="text-white-50">Restablecer Contraseña</small>
        </div>
        <div class="card-body p-4">
            @if (verificandoToken)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="text-muted small mb-0">Verificando enlace de seguridad...</p>
                </div>
            }
            else if (!tokenValido)
            {
                <div class="text-center py-3">
                    <div class="text-danger mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-shield-x" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                            <path d="M6.146 5.146a.5.5 0 0 1 .708 0L8 6.293l1.146-1.147a.5.5 0 0 1 .708.708L8.707 7l1.147 1.146a.5.5 0 0 1-.708.708L8 7.707 6.854 8.854a.5.5 0 1 1-.708-.708L7.293 7 6.146 5.854a.5.5 0 0 1 0-.708"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Enlace no válido o expirado</h5>
                    <p class="text-muted small mb-4">
                        El enlace de restablecimiento ha expirado (su vigencia es de 15 minutos) o ya fue utilizado anteriormente.
                    </p>
                    <a href="/olvide-mi-contrasena" class="btn btn-primary w-100 py-2 fw-semibold mb-2">
                        Solicitar un nuevo enlace
                    </a>
                    <a href="/login" class="btn btn-link text-muted small text-decoration-none">
                        Ir al inicio de sesión
                    </a>
                </div>
            }
            else if (restablecidoExitoso)
            {
                <div class="text-center py-3">
                    <div class="text-success mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">¡Contraseña Actualizada!</h5>
                    <p class="text-muted small mb-4">
                        @mensajeExito
                    </p>
                    <a href="/login" class="btn btn-success btn-lg w-100 py-2 fw-semibold">
                        Iniciar Sesión con mi nueva contraseña
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted small mb-3">
                    Ingresa y confirma tu nueva contraseña. Cumple con los requisitos de seguridad mostrados abajo.
                </p>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="nuevaPwd">Nueva Contraseña</label>
                    <div class="input-group">
                        <input id="nuevaPwd"
                               type="@(mostrarPwd ? "text" : "password")"
                               autocomplete="new-password"
                               class="form-control form-control-lg"
                               placeholder="Nueva contraseña"
                               @bind="nuevaPassword"
                               @bind:after="AlCambiarPassword"
                               disabled="@guardando" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => mostrarPwd = !mostrarPwd">
                            @(mostrarPwd ? "Ocultar" : "Mostrar")
                        </button>
                    </div>

                    <!-- Medidor de Fuerza -->
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar @BarraClase"
                             role="progressbar"
                             style="width: @(PuntajeFuerza * 20)%; transition: width 0.3s ease;">
                        </div>
                    </div>

                    <!-- Checklist de requisitos según política -->
                    <ul class="list-unstyled small mt-2 mb-0" style="font-size: 0.82rem;">
                        <li class="@(CumpleLongitud ? "text-success fw-semibold" : "text-muted")">
                            @(CumpleLongitud ? "✓" : "○") Mínimo @configPolitica.LongitudMinima caracteres
                        </li>
                        @if (configPolitica.RequiereMayusculas)
                        {
                            <li class="@(CumpleMayuscula ? "text-success fw-semibold" : "text-muted")">
                                @(CumpleMayuscula ? "✓" : "○") Al menos una letra mayúscula
                            </li>
                        }
                        @if (configPolitica.RequiereMinusculas)
                        {
                            <li class="@(CumpleMinuscula ? "text-success fw-semibold" : "text-muted")">
                                @(CumpleMinuscula ? "✓" : "○") Al menos una letra minúscula
                            </li>
                        }
                        @if (configPolitica.RequiereNumeros)
                        {
                            <li class="@(CumpleNumero ? "text-success fw-semibold" : "text-muted")">
                                @(CumpleNumero ? "✓" : "○") Al menos un número
                            </li>
                        }
                        @if (configPolitica.RequiereEspecial)
                        {
                            <li class="@(CumpleEspecial ? "text-success fw-semibold" : "text-muted")">
                                @(CumpleEspecial ? "✓" : "○") Al menos un carácter especial (!@@, #, $, %, ...)
                            </li>
                        }
                    </ul>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="confirmarPwd">Confirmar Contraseña</label>
                    <div class="input-group">
                        <input id="confirmarPwd"
                               type="@(mostrarConfirm ? "text" : "password")"
                               autocomplete="new-password"
                               class="form-control form-control-lg"
                               placeholder="Confirma la nueva contraseña"
                               @bind="confirmarPassword"
                               disabled="@guardando" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => mostrarConfirm = !mostrarConfirm">
                            @(mostrarConfirm ? "Ocultar" : "Mostrar")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(confirmarPassword) && nuevaPassword != confirmarPassword)
                    {
                        <div class="text-danger small mt-1">
                            Las contraseñas no coinciden.
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        @error
                    </div>
                }

                <button class="btn btn-primary btn-lg w-100 fw-semibold mb-3"
                        @onclick="Restablecer"
                        disabled="@(guardando || !FormularioValido)">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Actualizando...</span>
                    }
                    else
                    {
                        <span>Restablecer Contraseña</span>
                    }
                </button>

                <div class="text-center">
                    <a href="/login" class="text-decoration-none small text-muted">
                        ← Cancelar y volver al inicio de sesión
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private bool verificandoToken = true;
    private bool tokenValido = false;
    private bool guardando = false;
    private bool restablecidoExitoso = false;
    private string mensajeExito = "";
    private string error = "";

    private string nuevaPassword = "";
    private string confirmarPassword = "";
    private bool mostrarPwd = false;
    private bool mostrarConfirm = false;

    private PasswordConfigDto configPolitica = new(20, 3, 90, true, true, true, true);

    private bool CumpleLongitud => !string.IsNullOrEmpty(nuevaPassword) && nuevaPassword.Length >= configPolitica.LongitudMinima;
    private bool CumpleMayuscula => !string.IsNullOrEmpty(nuevaPassword) && nuevaPassword.Any(char.IsUpper);
    private bool CumpleMinuscula => !string.IsNullOrEmpty(nuevaPassword) && nuevaPassword.Any(char.IsLower);
    private bool CumpleNumero => !string.IsNullOrEmpty(nuevaPassword) && nuevaPassword.Any(char.IsDigit);
    private bool CumpleEspecial => !string.IsNullOrEmpty(nuevaPassword) && nuevaPassword.Any(c => !char.IsLetterOrDigit(c));

    private int PuntajeFuerza
    {
        get
        {
            int score = 0;
            if (CumpleLongitud) score++;
            if (CumpleMayuscula) score++;
            if (CumpleMinuscula) score++;
            if (CumpleNumero) score++;
            if (CumpleEspecial) score++;
            return score;
        }
    }

    private string BarraClase => PuntajeFuerza switch
    {
        <= 2 => "bg-danger",
        3 or 4 => "bg-warning",
        _ => "bg-success"
    };

    private bool FormularioValido =>
        PuntajeFuerza == 5 &&
        !string.IsNullOrEmpty(confirmarPassword) &&
        nuevaPassword == confirmarPassword;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            configPolitica = await PoliticaPwd.ObtenerAsync();
        }
        catch
        {
            configPolitica = new(20, 3, 90, true, true, true, true);
        }

        if (string.IsNullOrWhiteSpace(Token))
        {
            tokenValido = false;
            verificandoToken = false;
            return;
        }

        try
        {
            tokenValido = await Auth.ValidarTokenRecuperacionAsync(Token);
        }
        catch
        {
            tokenValido = false;
        }
        finally
        {
            verificandoToken = false;
        }
    }

    private void AlCambiarPassword()
    {
        StateHasChanged();
    }

    private async Task Restablecer()
    {
        if (guardando || !FormularioValido || string.IsNullOrWhiteSpace(Token)) return;

        guardando = true;
        error = "";
        StateHasChanged();

        try
        {
            var res = await Auth.RestablecerPasswordAsync(Token, nuevaPassword, confirmarPassword);
            if (res.Exitoso)
            {
                mensajeExito = res.Mensaje;
                restablecidoExitoso = true;
            }
            else
            {
                error = res.Mensaje;
            }
        }
        catch (Exception ex)
        {
            error = "Ocurrió un error inesperado al restablecer la contraseña: " + ex.Message;
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }
}
