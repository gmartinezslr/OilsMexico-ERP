@page "/configuracion"
@rendermode InteractiveServer
@inject OilsMexico.Application.Interfaces.ISesionActual Sesion
@inject NavigationManager Nav
<PageTitle>Configuración | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Configuración del sistema</h3>
        <span class="text-muted small">@(Sesion.Sesion?.Nombre ?? "") (@(Sesion.Sesion?.Rol ?? ""))</span>
    </div>
    @if (!Sesion.Autenticado)
    {
        <div class="alert alert-warning">Inicia sesión primero. <a href="/login">Ir al login</a></div>
    }
    else if (!esAdmin)
    {
        <div class="alert alert-info">Solo el rol <strong>Admin</strong> puede modificar la configuración.</div>
    }
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold mb-0">Configuración del sistema</h5>
                <span class="badge bg-secondary">Paso @paso de 3</span>
            </div>
            <div class="progress my-2" style="height:6px">
                <div class="progress-bar" role="progressbar" style="width:@(paso * 100 / 3)%"></div>
            </div>
            <div class="btn-group btn-group-sm mb-3" role="group" aria-label="Pasos de configuración">
                <button type="button" class="btn @(paso == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(1)">1 · Sesión y contraseñas</button>
                <button type="button" class="btn @(paso == 2 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(2)">2 · Bloqueo y correo</button>
                <button type="button" class="btn @(paso == 3 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(3)">3 · Moratorias</button>
            </div>
        </div>
    </div>

    <div class="row g-3">
    @if (paso == 1)
    {
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">Sesión</div>
                <div class="card-body">
                    <label class="form-label" for="minTimeout">Cerrar sesión tras inactividad de (minutos)</label>
                    <input id="minTimeout" type="number" min="1" max="480" class="form-control"
                           style="max-width:160px" @bind="minutos" disabled="@(!esAdmin || guardando)" />
                    <div class="form-text">
                        Tras este tiempo sin actividad se cierra la sesión y se redirige al login.
                        Rango permitido: 1 a 480 minutos (8 horas). Por defecto: 5 minutos.
                    </div>
                    <button class="btn btn-primary mt-3" @onclick="Guardar" disabled="@(!esAdmin || guardando)">
                        @(guardando ? "Guardando…" : "Guardar")
                    </button>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">Política de contraseñas</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label class="form-label" for="pwdMin">Longitud mínima</label>
                            <input id="pwdMin" type="number" min="4" max="100" class="form-control" style="max-width:120px"
                                   @bind="pwdMin" disabled="@(!esAdmin || guardandoPwd)" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="pwdHist">Historial (no repetir)</label>
                            <input id="pwdHist" type="number" min="0" max="20" class="form-control" style="max-width:120px"
                                   @bind="pwdHist" disabled="@(!esAdmin || guardandoPwd)" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="pwdDias">Vigencia (días)</label>
                            <input id="pwdDias" type="number" min="0" max="3650" class="form-control" style="max-width:120px"
                                   @bind="pwdDias" disabled="@(!esAdmin || guardandoPwd)" />
                        </div>
                    </div>
                    <div class="form-text">
                        Toda contraseña exige mayúscula, minúscula, número y carácter especial (no configurable).
                        «Historial» controla cuántas contraseñas anteriores no pueden repetirse; «Vigencia» en días
                        obliga a cambiarla al vencer (0 = sin vencimiento). Por defecto: 20 caracteres, 3 de historial, 90 días.
                    </div>
                    <button class="btn btn-primary mt-3" @onclick="GuardarPwd" disabled="@(!esAdmin || guardandoPwd)">
                        @(guardandoPwd ? "Guardando…" : "Guardar política")
                    </button>
                </div>
            </div>
        </div>
    }
    else if (paso == 2)
    {
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">Bloqueo por intentos de acceso</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <label class="form-label" for="bloqIntentos">Intentos fallidos</label>
                            <input id="bloqIntentos" type="number" min="1" max="10" class="form-control" style="max-width:120px"
                                   @bind="bloqIntentos" disabled="@(!esAdmin || guardandoBloqueo)" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="bloqMinutos">Minutos de bloqueo</label>
                            <input id="bloqMinutos" type="number" min="1" max="1440" class="form-control" style="max-width:120px"
                                   @bind="bloqMinutos" disabled="@(!esAdmin || guardandoBloqueo)" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="bloqDefinitivo">Bloqueos para el definitivo</label>
                            <input id="bloqDefinitivo" type="number" min="1" max="10" class="form-control" style="max-width:120px"
                                   @bind="bloqDefinitivo" disabled="@(!esAdmin || guardandoBloqueo)" />
                        </div>
                    </div>
                    <div class="form-text">
                        Al agotar los intentos fallidos la cuenta se bloquea temporalmente; al llegar al número
                        de bloques indicado el bloqueo pasa a ser definitivo (solo un Admin puede desbloquear).
                        Por defecto: 3 intentos, 30 minutos, 2 bloques. Los valores se persisten en la tabla
                        <code>configuracion</code> y aplican en el siguiente intento de acceso.
                    </div>
                    <button class="btn btn-primary mt-3" @onclick="GuardarBloqueo" disabled="@(!esAdmin || guardandoBloqueo)">
                        @(guardandoBloqueo ? "Guardando…" : "Guardar política")
                    </button>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <OilsMexico.Web.Components.Shared.ConfigCorreo AlGuardar="AlGuardarCorreo" />
        </div>
    }
    else if (paso == 3)
    {
        <div class="col-lg-6">
            <div class="card shadow-sm"><div class="card-header bg-dark text-white">Intereses moratorios</div><div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6"><label class="form-label">Tasa diaria CxC (decimal)</label><input type="number" min="0" max="1" step="0.0001" class="form-control" @bind="tasaCxc" disabled="@(!esAdmin || guardandoMora)" /></div>
                    <div class="col-sm-6"><label class="form-label">Tasa diaria CxP (decimal)</label><input type="number" min="0" max="1" step="0.0001" class="form-control" @bind="tasaCxp" disabled="@(!esAdmin || guardandoMora)" /></div>
                </div><div class="form-text">Ejemplo: 0.0005 equivale a 0.05% por día simple. Cero desactiva el cálculo.</div>
                <button class="btn btn-primary mt-3" @onclick="GuardarMora" disabled="@(!esAdmin || guardandoMora)">Guardar tasas</button>
            </div></div>
        </div>
    }
    </div>

    <div class="d-flex justify-content-between gap-2 mt-3">
        <button class="btn btn-outline-secondary" disabled="@(paso == 1)" @onclick="Anterior">← Anterior</button>
        <div class="d-flex gap-2">
            @if (paso < 3)
            {
                <button class="btn btn-primary" @onclick="Siguiente">Siguiente →</button>
            }
        </div>
    </div>
</div>

@code {
    private void AlGuardarCorreo(string mensaje) { msg = mensaje; err = false; }
}
