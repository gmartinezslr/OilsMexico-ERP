@page "/reportes"
@using OilsMexico.Application.Interfaces
@using OilsMexico.Domain.Enums
@using OilsMexico.Application.DTOs

<PageTitle>Reportes Financieros</PageTitle>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Reportes Financieros</h3>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Sucursal</label>
                <select class="form-select" @bind="@_sucursalId" @bind:after="@OnSucursalChange">
                    <option value="0">Todas</option>
                    @if (_sucursales != null)
                    {
                        @foreach (var s in _sucursales)
                        {
                            <option value="@s.Id" selected="@(_sucursalId == s.Id)">@s.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Desde</label>
                <input class="form-control" type="date" @bind="@_desde" @bind:after="@Cargar" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Hasta</label>
                <input class="form-control" type="date" @bind="@_hasta" @bind:after="@Cargar" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Corte (Balance)</label>
                <input class="form-control" type="date" @bind="@_corte" @bind:after="@Cargar" />
            </div>
        </div>

        @* Barra de exportaciones Excel/PDF (§2.1) — descarga directa vía /api/export/* *@
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="align-self-center text-muted me-1">Exportar:</span>
            <a class="btn btn-sm btn-outline-success" href="@UrlVentasXlsx">⬇ Ventas (Excel)</a>
            <a class="btn btn-sm btn-outline-success" href="@UrlInventarioXlsx">⬇ Inventario (Excel)</a>
            <a class="btn btn-sm btn-outline-success" href="@UrlCxcXlsx">⬇ CxC (Excel)</a>
            <a class="btn btn-sm btn-outline-success" href="@UrlCxpXlsx">⬇ CxP (Excel)</a>
            <a class="btn btn-sm btn-outline-success" href="@UrlGastosXlsx">⬇ Gastos (Excel)</a>
            <a class="btn btn-sm btn-outline-success" href="@UrlComisionesXlsx">⬇ Comisiones (Excel)</a>
            <a class="btn btn-sm btn-outline-success" href="@UrlListaPreciosXlsx">⬇ Lista de precios (Excel)</a>
        </div>

        @if (_cargando)
        {
            <div class="alert alert-secondary">Cargando...</div>
        }
        else if (_errores != null)
        {
            <div class="alert alert-danger">@_errores</div>
        }
        else
        {
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(_tab == "balanza" ? "active" : "")" @onclick='() => SeleccionarTab("balanza")'>Balanza</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_tab == "balance" ? "active" : "")" @onclick='() => SeleccionarTab("balance")'>Balance</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_tab == "resultados" ? "active" : "")" @onclick='() => SeleccionarTab("resultados")'>Resultados</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_tab == "existencias" ? "active" : "")" @onclick='() => SeleccionarTab("existencias")'>Existencias</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(_tab == "indicadores" ? "active" : "")" @onclick='() => SeleccionarTab("indicadores")'>Indicadores</button>
                </li>
            </ul>

            <div class="tab-content pt-3">
@* ---------- BALANZA DE COMPROBACIÓN ---------- *@
                @if (_tab == "balanza" && _balanza != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Periodo @_balanza.Desde.ToString("dd/MM/yyyy") — @_balanza.Hasta.ToString("dd/MM/yyyy")</span>
                        <a class="btn btn-sm btn-outline-danger" href="@UrlBalanzaPdf">⬇ PDF</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th><th>Cuenta</th>
                                    <th class="text-end">Débitos</th><th class="text-end">Créditos</th>
                                    <th class="text-end">Saldo Deudor</th><th class="text-end">Saldo Acreedor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _balanza.Renglones)
                                {
                                    <tr>
                                        <td>@r.Codigo</td>
                                        <td>@r.Nombre</td>
                                        <td class="text-end">@r.Debitos.ToString("N2")</td>
                                        <td class="text-end">@r.Creditos.ToString("N2")</td>
                                        <td class="text-end">@r.SaldoDeudor.ToString("N2")</td>
                                        <td class="text-end">@r.SaldoAcreedor.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="fw-bold">
                                <tr>
                                    <td colspan="2">Totales</td>
                                    <td class="text-end">@_balanza.TotalDebitos.ToString("N2")</td>
                                    <td class="text-end">@_balanza.TotalCreditos.ToString("N2")</td>
                                    <td class="text-end">@_balanza.TotalDeudor.ToString("N2")</td>
                                    <td class="text-end">@_balanza.TotalAcreedor.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }

                @* ---------- BALANCE GENERAL ---------- *@
                @if (_tab == "balance" && _balance != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Corte al @_balance.Corte.ToString("dd/MM/yyyy")</span>
                        <a class="btn btn-sm btn-outline-danger" href="@UrlBalancePdf">⬇ PDF</a>
                    </div>
                    <div class="row">
                        @foreach (var sec in new[] { _balance.Activo, _balance.Pasivo, _balance.Patrimonio })
                        {
                            <div class="col-md-4">
                                <h6 class="fw-bold">@sec.Titulo</h6>
                                <table class="table table-bordered table-sm">
                                    <tbody>
                                        @foreach (var c in sec.Cuentas)
                                        {
                                            <tr><td>@c.Codigo</td><td>@c.Nombre</td><td class="text-end">@c.Saldo.ToString("N2")</td></tr>
                                        }
                                    </tbody>
                                    <tfoot class="fw-bold">
                                        <tr><td colspan="2">Total</td><td class="text-end">@sec.Total.ToString("N2")</td></tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="alert @(_balance.Cuadrado ? "alert-success" : "alert-danger")">
                        Activo: <strong>@_balance.TotalActivo.ToString("N2")</strong> ·
                        Pasivo + Patrimonio: <strong>@_balance.TotalPasivoPatrimonio.ToString("N2")</strong> ·
                        @(_balance.Cuadrado ? "✓ Cuadrado" : "✗ Descuadrado")
                    </div>
                }

                @* ---------- ESTADO DE RESULTADOS ---------- *@
                @if (_tab == "resultados" && _resultados != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Periodo @_resultados.Desde.ToString("dd/MM/yyyy") — @_resultados.Hasta.ToString("dd/MM/yyyy")</span>
                        <a class="btn btn-sm btn-outline-danger" href="@UrlResultadosPdf">⬇ PDF</a>
                    </div>
                    <table class="table table-bordered" style="max-width:520px">
                        <tbody>
                            <tr><td>Ventas netas</td><td class="text-end">@_resultados.VentasNetas.ToString("N2")</td></tr>
                            <tr><td>Costo de ventas</td><td class="text-end">@_resultados.CostoVentas.ToString("N2")</td></tr>
                            <tr class="fw-bold"><td>Utilidad bruta</td><td class="text-end">@_resultados.UtilidadBruta.ToString("N2")</td></tr>
                            <tr><td>Gastos operativos</td><td class="text-end">@_resultados.GastosOperativos.ToString("N2")</td></tr>
                            <tr><td>IVA trasladado</td><td class="text-end">@_resultados.IvaTrasladado.ToString("N2")</td></tr>
                            <tr class="fw-bold table-light"><td>Utilidad neta</td><td class="text-end">@_resultados.UtilidadNeta.ToString("N2")</td></tr>
                            <tr><td>Margen bruto</td><td class="text-end">@_resultados.MargenBrutoPct.ToString("N2") %</td></tr>
                            <tr><td>Margen neto</td><td class="text-end">@_resultados.MargenNetoPct.ToString("N2") %</td></tr>
                        </tbody>
                    </table>
                }
@* ---------- CAMBIO DE EXISTENCIAS ---------- *@
                @if (_tab == "existencias" && _existencias != null)
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Periodo @_existencias.Desde.ToString("dd/MM/yyyy") — @_existencias.Hasta.ToString("dd/MM/yyyy")</span>
                        <a class="btn btn-sm btn-outline-danger" href="@UrlExistenciasPdf">⬇ PDF</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>SKU</th><th>Producto</th>
                                    <th class="text-end">Inicial</th><th class="text-end">Compras</th>
                                    <th class="text-end">Ventas</th><th class="text-end">Ajustes</th>
                                    <th class="text-end">Traspasos</th><th class="text-end">Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _existencias.Renglones)
                                {
                                    <tr>
                                        <td>@r.Sku</td>
                                        <td>@r.Nombre</td>
                                        <td class="text-end">@r.Inicial.ToString("N2")</td>
                                        <td class="text-end">@r.Compras.ToString("N2")</td>
                                        <td class="text-end">@r.Ventas.ToString("N2")</td>
                                        <td class="text-end">@r.Ajustes.ToString("N2")</td>
                                        <td class="text-end">@r.Traspasos.ToString("N2")</td>
                                        <td class="text-end">@r.Final.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* ---------- INDICADORES ---------- *@
                @if (_tab == "indicadores" && _indicadores != null)
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Sucursal</th>
                                    <th class="text-end">Ventas netas</th><th class="text-end">Utilidad bruta</th>
                                    <th class="text-end">Margen %</th><th class="text-end">Rotación</th>
                                    <th class="text-end">Días inv.</th><th class="text-end">Ticket prom.</th>
                                    <th class="text-end"># Ventas</th><th class="text-end">Inv. promedio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _indicadores)
                                {
                                    <tr>
                                        <td>@r.Sucursal</td>
                                        <td class="text-end">@r.VentasNetas.ToString("N2")</td>
                                        <td class="text-end">@r.UtilidadBruta.ToString("N2")</td>
                                        <td class="text-end">@r.MargenPct.ToString("N2")</td>
                                        <td class="text-end">@r.RotacionInventario.ToString("N2")</td>
                                        <td class="text-end">@r.DiasInventario.ToString("N2")</td>
                                        <td class="text-end">@r.TicketPromedio.ToString("N2")</td>
                                        <td class="text-end">@r.NumVentas</td>
                                        <td class="text-end">@r.InventarioPromedio.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>
