@page "/cotizaciones/detalle/{id}"
@rendermode InteractiveServer
@using OilsMexico.Application.DTOs
@using OilsMexico.Domain.Enums
<PageTitle>Detalle de cotización | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Detalle de cotización</h5>
        </div>
        <div class="card-body">
            @if (cargando)
            {
                <div class="alert alert-light">Cargando…</div>
            }
            else if (!string.IsNullOrEmpty(msg))
            {
                <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
            }
            else if (cotizacion is null)
            {
                <div class="alert alert-warning">Cotización no encontrada. <a href="/cotizaciones">Volver al listado</a></div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <dl class="row">
                            <dt class="col-sm-4 fw-semibold">Folio</dt>
                            <dd class="col-sm-8"><strong>@cotizacion.FolioInterno</strong></dd>
                            <dt class="col-sm-4 fw-semibold">Fecha</dt>
                            <dd class="col-sm-8">@cotizacion.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                            <dt class="col-sm-4 fw-semibold">Cliente</dt>
                            <dd class="col-sm-8">@cotizacion.Cliente</dd>
                            <dt class="col-sm-4 fw-semibold">Vendedor</dt>
                            <dd class="col-sm-8">@cotizacion.Vendedor ?? "—"</dd>

                            <dt class="col-sm-4 fw-semibold">Vence</dt>
                            <dd class="col-sm-8">@cotizacion.FechaVencimiento?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "sin validez"</dd>
                            <dt class="col-sm-4 fw-semibold">Estado</dt>
                            <dd class="col-sm-8"><span class="badge bg-@(ClaseEstado(cotizacion.Estado))">@cotizacion.Estado</span></dd>
                            <dt class="col-sm-4 fw-semibold">Total</dt>
                            <dd class="col-sm-8 text-danger">$@cotizacion.Total.ToString("N2")</dd>
                        </dl>
                    </div>
                    <div class="col-md-8">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="bg-secondary">
                                        <th style="width:34%">Producto</th>
                                        <th style="width:14%" class="text-end">Cant.</th>
                                        <th style="width:22%" class="text-end">Precio</th>
                                        <th style="width:16%" class="text-end">Desc.</th>
                                        <th style="width:14%" class="text-end">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in cotizacion.Detalles)
                                    {
                                        <tr class="align-middle">
                                            <td>@d.Sku &nbsp;-&nbsp; @d.Nombre</td>
                                            <td class="text-end">@d.Cantidad</td>
                                            <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                                            <td class="text-end">$@d.Descuento.ToString("N2")</td>
                                            <td class="text-end">$@d.Importe.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (cotizacion.Detalles.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted">Sin renglones.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            @if (Accion == "convertir")
            {
                <hr />
                <h6 class="mt-3">Convertir a orden de venta</h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label small">Vendedor</label>
                        <select class="form-select" @bind="vendedorConv">
                            <option value="0">Por defecto (dueño comercial)</option>
                            @foreach (var v in vendedores)
                            {
                                <option value="@v.Id" selected="@(v.Id == vendedorConv)">@v.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Folio de la orden</label>
                        <input class="form-control" type="text" @bind="folioConv" placeholder="OV-{suc}-{yyyymmddhhmmss}" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-success btn-sm" @onclick="ConfirmarConversion" disabled="@convenciendo">
                            @convenciendo ? "Convirtiendo…" : "Convertir a orden de venta"
                        </button>
                    </div>
                </div>
                <div class="mt-2"><small class="text-muted">El precio de la cotización se congela en la orden y el vendedor se asigna de forma definitiva.</small></div>
            }
            else if (Accion == "cancelar")
            {
                <hr />
                <h6 class="mt-3">Cancelar cotización</h6>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small">Motivo</label>
                        <input class="form-control" @bind="motivoCancel" placeholder="Motivo de cancelación" />
                    </div>
                    <div class="col-md-6">
                        <button class="btn btn-danger btn-sm" @onclick="ConfirmarCancelacion" disabled="@cancelando">
                            @cancelando ? "Cancelando…" : "Confirmar cancelación"
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex gap-2 mt-3 flex-wrap align-items-end">
                    <button class="btn btn-outline-success btn-sm" style="width:140px" @onclick="AbrirConvertir">Convertir a orden</button>
                    <button class="btn btn-outline-danger btn-sm" style="width:140px" @onclick="AbrirCancelar">Cancelar</button>
                    <div class="input-group input-group-sm" style="max-width:360px">
                        <input class="form-control" placeholder="Correo destino (vacio = cliente)…" @bind="correoDestino" disabled="@enviandoCorreo" />
                        <button class="btn btn-outline-primary" @onclick="EnviarPorCorreo" disabled="@enviandoCorreo">
                            @(enviandoCorreo ? "Enviando…" : "Enviar por correo")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

