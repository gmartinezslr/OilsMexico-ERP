@page "/corte-caja"
@rendermode InteractiveServer
@inject OilsMexico.Application.Interfaces.ICorteCajaService Caja
@inject OilsMexico.Application.Interfaces.ISucursalContext SucCtx
@inject OilsMexico.Application.Interfaces.ISesionActual Sesion
@inject NavigationManager Nav
@using OilsMexico.Application.DTOs
<PageTitle>Corte de caja | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Corte de caja <span class="badge bg-secondary">Suc @SucCtx.SucursalId</span></h3>
        <span class="text-muted small">@(Sesion.Sesion?.Nombre ?? "") (@(Sesion.Sesion?.Rol ?? ""))</span>
    </div>
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
    }
    @if (abierto is null)
    {
        <div class="card shadow-sm mb-3"><div class="card-body">
            <h5 class="fw-bold">Abrir turno</h5>
            <div class="row g-2 align-items-end">
                <div class="col-md-3"><label class="form-label small">Fondo inicial</label>
                    <div class="input-group"><span class="input-group-text">$</span>
                    <input type="number" step="0.01" min="0" class="form-control" @bind="fondo" /></div></div>
                <div class="col-md-3"><button class="btn btn-success" disabled="@cargando" @onclick="Abrir">Abrir caja</button></div>
            </div>
        </div></div>
    }
    else
    {
        <div class="card shadow-sm border-success mb-3">
            <div class="card-header bg-success text-white fw-bold">Turno abierto · @abierto.UsuarioApertura</div>
            <div class="card-body">
                @if (foto is not null)
                {
                    <div class="row g-2 text-center mb-2">
                        <div class="col"><div class="border rounded p-2"><small>Ventas</small><div class="fs-4 fw-bold">@foto.NumVentas</div></div></div>
                        <div class="col"><div class="border rounded p-2"><small>Efectivo</small><div class="fw-bold">$@foto.EfectivoSistema.ToString("N2")</div></div></div>
                        <div class="col"><div class="border rounded p-2"><small>Tarjeta</small><div>$@foto.TarjetaSistema.ToString("N2")</div></div></div>
                        <div class="col"><div class="border rounded p-2"><small>Transfer</small><div>$@foto.TransferSistema.ToString("N2")</div></div></div>
                        <div class="col"><div class="border rounded p-2"><small>Total</small><div class="fw-bold text-success">$@foto.TotalVentasSistema.ToString("N2")</div></div></div>
                    </div>
                }
                <div class="row g-2 align-items-end">
                    <div class="col-md-3"><label class="form-label small">Efectivo contado</label>
                        <div class="input-group"><span class="input-group-text">$</span>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="contado" /></div></div>
                    <div class="col-md-4"><label class="form-label small">Observaciones</label>
                        <input class="form-control" maxlength="300" @bind="obs" /></div>
                    <div class="col-md-5 d-flex gap-2">
                        <button class="btn btn-outline-primary" disabled="@cargando" @onclick="Refrescar">Actualizar</button>
                        <button class="btn btn-danger flex-fill" disabled="@cargando" @onclick="Cerrar">Cerrar y cuadrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="card shadow-sm"><div class="card-body p-0">
        <div class="table-responsive" style="max-height:45vh;overflow-y:auto">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead class="table-dark position-sticky top-0"><tr><th>Apertura</th><th>Cierre</th><th>Cajero</th><th>Estado</th><th class="text-end">Ventas</th><th class="text-end">Contado</th><th class="text-end">Dif.</th></tr></thead>
                <tbody>
                @foreach (var c in historial)
                {
                    <tr>
                        <td class="small">@c.FechaAperturaUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="small">@(c.FechaCierreUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                        <td class="small">@c.UsuarioApertura</td>
                        <td><span class="badge @(c.Estado == "Abierto" ? "bg-success" : c.Diferencia == 0 ? "bg-primary" : "bg-danger")">@c.Estado</span></td>
                        <td class="text-end">$@c.TotalVentasSistema.ToString("N2")</td>
                        <td class="text-end">$@c.EfectivoContado.ToString("N2")</td>
                        <td class="text-end fw-bold @(c.Diferencia == 0 ? "text-success" : "text-danger")">$@c.Diferencia.ToString("N2")</td>
                    </tr>
                }
                @if (historial.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Sin cortes recientes.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div></div>
    <small class="text-muted d-block mt-2">Diferencia = contado − (fondo + efectivo del sistema).</small>
</div>
