@page "/gastos"
@rendermode InteractiveServer
@inject OilsMexico.Application.Interfaces.IGastoService GastosSvc
@inject OilsMexico.Application.Interfaces.ISucursalContext SucCtx
@inject OilsMexico.Application.Interfaces.ISesionActual Sesion
@inject NavigationManager Nav
@using OilsMexico.Application.DTOs
@using OilsMexico.Domain.Enums
<PageTitle>Gastos operativos | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Gastos operativos <span class="badge bg-secondary">Suc @SucCtx.SucursalId</span></h3>
        <span class="text-muted small">@(Sesion.Sesion?.Nombre ?? "") (@(Sesion.Sesion?.Rol ?? ""))</span>
    </div>
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
    }
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-2"><label class="form-label small mb-1">Desde</label>
                <input type="date" class="form-control form-control-sm" @bind="desde" @bind:after="Cargar" /></div>
            <div class="col-md-2"><label class="form-label small mb-1">Hasta</label>
                <input type="date" class="form-control form-control-sm" @bind="hasta" @bind:after="Cargar" /></div>
            <div class="col-md-2"><label class="form-label small mb-1">Categoría</label>
                <select class="form-select form-select-sm" @bind="categoria" @bind:after="Cargar">
                    <option value="">Todas</option>
                    @foreach (var c in Categorias)
                    {
                        <option value="@c">@c</option>
                    }
                </select></div>
            <div class="col-md-2"><label class="form-label small mb-1">Total período</label>
                <div class="fw-bold fs-5">$@TotalPeriodo.ToString("N2")</div></div>
            <div class="col-md-4">
                <button class="btn btn-primary btn-sm w-100" @onclick="Cargar" disabled="@cargando">Buscar</button>
            </div>
        </div>
    </div></div>
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm"><div class="card-header fw-bold">Movimientos (@lista.Count)</div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height:560px;overflow-y:auto">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-dark position-sticky top-0"><tr><th>Fecha</th><th>Categoría</th><th>Concepto</th><th class="text-end">Importe</th><th>Forma</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var g in lista)
                        {
                            <tr>
                                <td class="small">@g.Fecha.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td><span class="badge bg-secondary">@g.Categoria</span></td>
                                <td class="small">@g.Concepto<br /><small class="text-muted">@(g.Comprobante ?? "s/comprobante") · @g.Usuario</small></td>
                                <td class="text-end fw-bold">$@g.Importe.ToString("N2")</td>
                                <td class="small">@g.FormaPagoSat</td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EmpezarEditar(g)">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(g.GastoId)">✕</button>
                                </td>
                            </tr>
                        }
                        @if (lista.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Sin gastos en el período.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div></div>
            <div class="card shadow-sm mt-3"><div class="card-header fw-bold">Reporte por categoría</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0"><thead><tr><th>Categoría</th><th class="text-center">Movs</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                @foreach (var t in totales)
                {
                    <tr><td>@t.Categoria</td><td class="text-center">@t.Movimientos</td><td class="text-end fw-bold">$@t.Total.ToString("N2")</td></tr>
                }
                @if (totales.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted">Sin datos.</td></tr>
                }
                </tbody></table>
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm"><div class="card-header fw-bold">@(editando ? $"Editar gasto #{editId}" : "Nuevo gasto")</div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6"><label class="form-label small mb-1">Fecha</label>
                        <input type="datetime-local" class="form-control form-control-sm" @bind="fecha" /></div>
                    <div class="col-md-6"><label class="form-label small mb-1">Categoría</label>
                        <select class="form-select form-select-sm" @bind="cat">
                            @foreach (var c in Categorias)
                            {
                                <option value="@c">@c</option>
                            }
                        </select></div>
                    <div class="col-12"><label class="form-label small mb-1">Concepto</label>
                        <input class="form-control form-control-sm" maxlength="200" placeholder="Ej: Gasolina reparto" @bind="concepto" /></div>
                    <div class="col-md-6"><label class="form-label small mb-1">Importe</label>
                        <div class="input-group input-group-sm"><span class="input-group-text">$</span>
                        <input type="number" step="0.01" min="0.01" class="form-control" @bind="importe" /></div></div>
                    <div class="col-md-6"><label class="form-label small mb-1">Forma pago SAT</label>
                        <select class="form-select form-select-sm" @bind="forma">
                            <option value="01">01 Efectivo</option>
                            <option value="02">02 Cheque</option>
                            <option value="03">03 Transferencia</option>
                            <option value="04">04 T. crédito</option>
                            <option value="28">28 T. débito</option>
                            <option value="99">99 Por definir</option>
                        </select></div>
                    <div class="col-md-6"><label class="form-label small mb-1">Comprobante</label>
                        <input class="form-control form-control-sm" maxlength="100" placeholder="Folio ticket" @bind="comprobante" /></div>
                    <div class="col-md-6"><label class="form-label small mb-1">Notas</label>
                        <input class="form-control form-control-sm" placeholder="Opcional" @bind="notas" /></div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-success btn-sm flex-fill" @onclick="Guardar" disabled="@guardando">Guardar</button>
                        @if (editando)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelarEdicion">Cancelar</button>
                        }
                    </div>
                </div>
                <small class="text-muted d-block mt-2">Los gastos en efectivo (01) descuentan del cuadre del corte abierto. Cada gasto genera su póliza.</small>
            </div></div>
        </div>
    </div>
</div>
@code {
    private static string[] Categorias => Enum.GetNames<CategoriaGasto>();
}
