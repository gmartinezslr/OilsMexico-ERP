@page "/proveedores"
@rendermode InteractiveServer
@inject OilsMexico.Application.Interfaces.ISesionActual Sesion
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@using OilsMexico.Web.Components.Shared
<PageTitle>Proveedores | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Proveedores
            <AyudaContextual Titulo="Alta de proveedores en 4 pasos"
                Texto="1) Datos fiscales: nombre y RFC válido. 2) Situación fiscal (Cancelada/Baja bloquea). 3) Direcciones: varios domicilios SEPOMEX. 4) Contactos: múltiples medios y puesto/cargo obligatorio por persona." />
        </h3>
        <button class="btn btn-primary" @onclick="Nuevo">+ Nuevo proveedor</button>
    </div>
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
    }
    <div class="row g-3">
        <div class="col-lg-5">
            <input class="form-control mb-2" placeholder="Buscar nombre o RFC…" value="@filtro" @oninput="AlEscribir" />
            <div class="list-group" style="max-height:560px;overflow-y:auto">
                @foreach (var p in lista)
                {
                    <button type="button" class="list-group-item list-group-item-action @(edit.Id == p.Id ? "active" : "")" @onclick="() => Editar(p.Id)">
                        <strong>@p.Nombre</strong><br />
                        <small>@p.Rfc · @p.CodigoPostal @p.Colonia</small>
                    </button>
                }
                @if (lista.Count == 0)
                {
                    <div class="list-group-item text-muted">Sin resultados.</div>
                }
            </div>
        </div>
        <div class="col-lg-7"><div class="card shadow-sm"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">@(edit.Id == 0 ? "Nuevo proveedor" : $"Editar #{edit.Id}")</h5>
                <span class="badge bg-secondary">Paso @paso de 4</span>
            </div>
            <div class="progress my-2" style="height:6px">
                <div class="progress-bar" role="progressbar" style="width:@(paso * 100 / 4)%"></div>
            </div>
            <div class="btn-group btn-group-sm mb-3" role="group" aria-label="Pasos del alta">
                <button type="button" class="btn @(paso == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(1)">1 · Datos</button>
                <button type="button" class="btn @(paso == 2 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(2)">2 · Facturación</button>
                <button type="button" class="btn @(paso == 3 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(3)">3 · Direcciones</button>
                <button type="button" class="btn @(paso == 4 ? "btn-primary" : "btn-outline-primary")" @onclick="() => IrPaso(4)">4 · Contactos</button>
            </div>
            @if (paso == 1)
            {
            <div class="row g-2">
                <div class="col-md-8"><label class="form-label small">Nombre / Razón social *</label>
                    <input class="form-control" @bind="edit.Nombre" /></div>
                <div class="col-md-4"><label class="form-label small">RFC *</label>
                    <input class="form-control" maxlength="13" @bind="edit.Rfc" @onblur="ValidarRfcCampo" />
                    @if (!string.IsNullOrEmpty(rfcInfo))
                    {
                        <small class="@(rfcErr ? "text-danger" : "text-success")">@rfcInfo</small>
                    }</div>
            </div>
            }
            else if (paso == 2)
            {
            <div class="row g-2">
                <div class="col-md-12"><label class="form-label small">Situación fiscal (SAT)</label>
                    <select class="form-select" @bind="edit.SituacionFiscal">
                        @if (catalogos.SituacionesFiscales.Count > 0)
                        {
                            @foreach (var kv in catalogos.SituacionesFiscales)
                            {
                                <option value="@kv.Key">@kv.Value</option>
                            }
                        }
                        else
                        {
                            <option value="Actual">Actual — operaciones normales</option>
                            <option value="Adeudada">Adeudada — obligaciones fiscales pendientes</option>
                            <option value="Inactiva">Inactiva — no opera en el periodo</option>
                            <option value="Suspendida">Suspendida — incumplimientos temporales</option>
                            <option value="Cancelada">Cancelada — anulada ante el SAT (no operar)</option>
                            <option value="Baja">Baja — baja definitiva (no operar)</option>
                        }
                    </select>
                    <small class="text-muted">Cancelada/Baja bloquea el guardado aunque el RFC sea válido.</small></div>
            </div>
            }
            else if (paso == 3)
            {
                <TerceroDireccionesEditor Direcciones="edit.Direcciones" Contactos="edit.Contactos" />
            }
            else
            {
                <TerceroContactosEditor EsCliente="false" Contactos="edit.Contactos"
                                        Correos="edit.Correos" Telefonos="edit.Telefonos" />
            }
            <div class="d-flex justify-content-between gap-2 mt-3">
                <button class="btn btn-outline-secondary" disabled="@(paso == 1)" @onclick="Anterior">← Anterior</button>
                <div class="d-flex gap-2">
                    @if (paso < 4)
                    {
                        <button class="btn btn-primary" @onclick="Siguiente">Siguiente →</button>
                    }
                    else
                    {
                        <button class="btn btn-success" @onclick="Guardar" disabled="@guardando">Guardar</button>
                    }
                    @if (edit.Id != 0)
                    {
                        <button class="btn btn-outline-danger" @onclick="Desactivar">Desactivar</button>
                    }
                </div>
            </div>
        </div></div></div>
    </div>
</div>
