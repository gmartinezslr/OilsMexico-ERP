@page "/ordenes-vente"
@rendermode InteractiveServer
@inject ICotizacionesConsulta CotizSvc
@inject ISucursalContext SucCtx
@inject ISesionActual Sesion
@inject NavigationManager Nav
@using OilsMexico.Application.DTOs
@using OilsMexico.Domain.Enums
<PageTitle>Órdenes de Venta | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <div class="d-flex gap-2 flex-wrap">
            <input class="form-control form-control-sm" placeholder="Folio o cliente"
                   @bind="filtroTexto" @bind:event="oninput" @bind:after="Cargar" />
            <select class="form-select form-select-sm" @bind="filtroEstado" @bind:after="Cargar">
                <option value="">Todos los estados</option>
                @foreach (var e in Enum.GetValues<EstadoOrdenVenta>())
                {
                    <option value="@e">@nombreEstado(e)</option>
                }
            </select>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="NuevaOrden">+ Nueva orden</button>
    </div>

    @if (cargando)
    {
        <div class="alert alert-light">Cargando órdenes…</div>
    }
    else if (!string.IsNullOrEmpty(msg))
    {
        <div class="alert @(err ? "alert-danger" : "alert-success")">@msg</div>
    }
    else if (lista.Count == 0)
    {
        <div class="alert alert-light">Sin órdenes de venta.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0 p-3">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr class="bg-secondary">
                            <th style="width:18%">Folio</th>
                            <th style="width:14%">Fecha</th>
                            <th style="width:18%">Cliente</th>
                            <th style="width:12%">Vendedor</th>
                            <th style="width:9%">Estado</th>
                            <th style="width:12%" class="text-end">Total</th>
                            <th style="width:9%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in lista)
                        {
                            <tr>
                                <td><strong>@o.FolioInterno</strong></td>
                                <td>@o.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.Cliente</td>
                                <td>@o.Vendedor ?? "—"</td>
                                <td>@o.Estado</td>
                                <td class="text-end">$@o.Total.ToString("N2")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" @onclick="() => AbrirDetalle(o.Id)">Ver</button>
                                        @if (o.Estado is EstadoOrdenVenta.Borrador)
                                        {
                                            <button class="btn btn-outline-danger" style="width:70px" @onclick="() => Cancelar(o.Id)">Cancelar</button>
                                        }
                                        @if (o.Estado is EstadoOrdenVenta.Confirmada)
                                        {
                                            <button class="btn btn-outline-warning" style="width:80px" @onclick="() => Suspender(o.Id)">Suspender</button>
                                        }
                                        @if (o.Estado is EstadoOrdenVenta.Suspendida)
                                        {
                                            <button class="btn btn-outline-success" style="width:80px" @onclick="() => Reanudar(o.Id)">Reanudar</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
