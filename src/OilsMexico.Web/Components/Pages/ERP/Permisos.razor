@page "/permisos"
@rendermode InteractiveServer
@inject IAutorizacionService Autorizacion
@inject ISesionActual Sesion
@inject NavigationManager Nav
<PageTitle>Permisos por rol | OilsMexico ERP</PageTitle>

<div class="container-fluid py-4 px-4" style="max-width:1400px;">
    <div class="mb-4">
        <h3 class="fw-bold mb-1">Permisos por rol</h3>
        <div class="text-muted">Administra el acceso a páginas del ERP por cada rol.</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(error ? "alert-danger" : "alert-success")" role="alert">@mensaje</div>
    }
    @if (cargando)
    {
        <div class="text-center py-5"><span class="spinner-border"></span> Cargando matriz…</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Página</th>
                            @foreach (var rol in roles)
                            {
                                <th scope="col" class="text-center">@rol</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grupo in matriz.GroupBy(p => p.Recurso))
                        {
                            var item = grupo.First();
                            <tr>
                                <th scope="row">@item.Etiqueta</th>
                                @foreach (var celda in grupo.OrderBy(x => x.Rol))
                                {
                                    <td class="text-center">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               aria-label="@($"{item.Etiqueta}: {celda.Rol}")"
                                               checked="@celda.Permitido"
                                               disabled="@(cargando || guardando || celda.Fijo)"
                                               @onchange="e => Cambiar(celda.RolId, celda.PermisoId, e)" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                <small class="text-muted">El rol Admin conserva todos los permisos para evitar bloquear la administración.</small>
                <button class="btn btn-primary" @onclick="Guardar" disabled="@(cargando || guardando || !hayCambios)">
                    @(guardando ? "Guardando…" : "Guardar cambios")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<RolPermisoMatrizDto> matriz = [];
    private List<string> roles = [];
    private Dictionary<int, HashSet<int>> cambios = [];
    private bool cargando = true;
    private bool guardando;
    private bool error;
    private bool hayCambios;
    private string? mensaje;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!Sesion.Autenticado && !await Sesion.RestaurarAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (Sesion.Sesion?.Rol != Roles.Admin)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            matriz = (await Autorizacion.ObtenerMatrizAsync()).ToList();
            roles = matriz.Select(x => x.Rol).Distinct().OrderBy(x => x).ToList();
            cambios = matriz.GroupBy(x => x.RolId)
                .ToDictionary(g => g.Key, g => g.Where(x => x.Permitido).Select(x => x.PermisoId).ToHashSet());
        }
        catch (Exception ex)
        {
            error = true;
            mensaje = $"No se pudo cargar la matriz de permisos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
        StateHasChanged();
    }

    private void Cambiar(int rolId, int permisoId, ChangeEventArgs args)
    {
        if (!cambios.TryGetValue(rolId, out var ids)) return;
        if (args.Value is bool permitido && permitido) ids.Add(permisoId);
        else ids.Remove(permisoId);
        hayCambios = true;
        mensaje = null;
    }

    private async Task Guardar()
    {
        if (guardando || !hayCambios) return;
        guardando = true;
        mensaje = null;
        error = false;
        try
        {
            await Autorizacion.GuardarMatrizAsync(cambios
                .Select(c => new RolPermisoMatrizActualizacionDto(c.Key, c.Value.ToList()))
                .ToList());
            matriz = (await Autorizacion.ObtenerMatrizAsync()).ToList();
            cambios = matriz.GroupBy(x => x.RolId)
                .ToDictionary(g => g.Key, g => g.Where(x => x.Permitido).Select(x => x.PermisoId).ToHashSet());
            hayCambios = false;
            mensaje = "Matriz de permisos actualizada.";
        }
        catch (Exception ex)
        {
            error = true;
            mensaje = $"No se pudo guardar la matriz: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }
}
