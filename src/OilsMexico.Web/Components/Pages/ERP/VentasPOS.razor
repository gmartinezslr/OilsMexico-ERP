@page "/ventas-pos"
@rendermode InteractiveServer
<PageTitle>Punto de Venta | OilsMexico ERP</PageTitle>
<div class="container-fluid py-3">
<div class="row mb-3 align-items-end">
<div class="col"><h3 class="fw-bold">Punto de Venta <span class="badge bg-primary">Suc @SucursalCtx.SucursalId</span>
@if (corteAbierto is null)
{
    <a href="/corte-caja" class="badge bg-warning text-dark text-decoration-none" title="Abrir turno">⚠ caja cerrada — abrir turno</a>
}
else
{
    <a href="/corte-caja" class="badge bg-success text-decoration-none" title="Ver corte">🟢 turno #@corteAbierto.CorteId</a>
}
</h3></div>
<div class="col-auto"><label class="form-label mb-0 small">Sucursal en sesion</label>
<select class="form-select" value="@SucursalCtx.SucursalId" @onchange="CambiarSucursal">
@foreach(var s in sucursales){<option value="@s.Id">@s.Nombre</option>}
</select></div>
</div>
@if(!string.IsNullOrEmpty(mensaje)){<div class="alert @(esError?"alert-danger":"alert-success")">@mensaje</div>}
<div class="row g-3">
<div class="col-lg-7"><div class="card shadow-sm">
<div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
<span>Buscar producto (SKU, marca, viscosidad o <span class="badge bg-warning text-dark">código de barras</span>)</span>
<button type="button" class="btn btn-sm btn-outline-light" title="¿Cómo escanear?"
        @onclick="() => mostrarAyudaScan = !mostrarAyudaScan">?</button>
</div>
<div class="card-body">
@if (mostrarAyudaScan)
{
    <div class="alert alert-info py-2 small mb-2">
        <strong>Escáner USB:</strong> coloca el cursor en el campo, escanea la etiqueta y el producto
        entra <strong>directo al carrito</strong> (Enter). También puedes pegar el código y pulsar Enter.
        Si el código no existe, se muestra aviso y queda en el buscador para darlo de alta en
        <a href="/productos">Productos → Presentaciones</a>.
    </div>
}
<input @ref="cajaScan" class="form-control form-control-lg font-monospace" placeholder="Escanea o escribe: 5W-30, Mobil, 7501234… (Enter = agregar)"
       value="@filtro" @oninput="AlEscribir" @onkeydown="AlTecla" />
<div class="border rounded p-2 mb-3 bg-light">
    <div class="fw-semibold small mb-1">Compatibilidad por vehículo (catálogo técnico)</div>
    <div class="row g-2 align-items-end">
        <div class="col"><label class="form-label small mb-1">Marca</label><input class="form-control form-control-sm" @bind="marcaVehiculo" /></div>
        <div class="col"><label class="form-label small mb-1">Modelo</label><input class="form-control form-control-sm" @bind="modeloVehiculo" /></div>
        <div class="col-3"><label class="form-label small mb-1">Año</label><input class="form-control form-control-sm" type="number" @bind="anioVehiculo" /></div>
        <div class="col-auto"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="BuscarCompatibilidad">Consultar</button></div>
    </div>
    @if (errorCompatibilidad is not null) { <div class="small text-muted mt-1">@errorCompatibilidad</div> }
    @if (compatibilidades.Count > 0)
    {
        <ul class="small mb-0 mt-2">
            @foreach (var c in compatibilidades)
            {
                <li><strong>@c.Marca @c.Modelo @c.AnioDesde–@c.AnioHasta</strong> · @c.Motor · @c.Viscosidad
                    @if (!string.IsNullOrWhiteSpace(c.Norma)) { <span> · @c.Norma</span> }
                    @if (c.CapacidadLitros.HasValue) { <span> · @c.CapacidadLitros.Value:N2 L</span> }
                    @if (!string.IsNullOrWhiteSpace(c.Producto)) { <span> · @c.Producto</span> }
                </li>
            }
        </ul>
    }
</div>
<div class="list-group mt-2" style="max-height:420px;overflow-y:auto">
@foreach(var p in productos){
<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @onclick="()=>Agregar(p)">
<span><strong>@p.Sku</strong> - @p.Nombre<br/>
<small class="text-muted">@p.Marca - @p.Viscosidad (@p.UnidadVenta) - Stock @p.StockSucursal.ToString("N2") L
@if (!string.IsNullOrEmpty(p.CodigoBarra))
{
    <span class="font-monospace"> · CB @p.CodigoBarra</span>
}</small></span>
<span class="badge bg-success fs-6">$@PrecioProducto(p).ToString("N2")</span>
</button>}
@if(productos.Count==0){<div class="list-group-item text-muted">Sin resultados.</div>}
</div>
</div></div></div>
<div class="col-lg-5"><div class="card shadow-sm">
<div class="card-header bg-primary text-white">Carrito (@carrito.Count)</div>
<div class="card-body">
@foreach(var it in carrito){
<div class="d-flex justify-content-between align-items-center border-bottom py-2">
<div><strong>@it.Nombre</strong><br/>
<small>@it.Cantidad.ToString("N2") @it.UnidadNombre × $@it.PrecioUnitario.ToString("N2") - $@it.Importe.ToString("N2")</small></div>
<button type="button" class="btn btn-sm btn-outline-danger" @onclick="()=>Quitar(it)">X</button>
</div>}
<hr/>


<div class="row g-2">
    <div class="row">
        <div class="col-7"><label class="form-label small">Forma pago SAT</label>
            <select class="form-select" @onchange="e=>formaPago=e.Value!.ToString()!">
            @foreach(var kv in catalogos.FormasPago){<option value="@kv.Key">@kv.Value</option>}
            </select>
        </div>
        <div class="col-5">
            <label class="form-label small d-block">&nbsp;</label>
            <label class="form-check-label" for="cfdi">Facturacion CFDI 4.0</label>
            <div class="form-check form-switch col-12 d-flex justify-content-center">
                <input class="form-check-input" type="checkbox" checked="true" id="cfdi" @onchange="e=>requiereFactura=(bool)e.Value!" />
            </div>
        </div>
    </div>
    <div class="col-12"><label class="form-label small">Metodo pago SAT</label>
    <select class="form-select" @onchange="e=>metodoPago=e.Value!.ToString()!">
    @foreach(var kv in catalogos.MetodosPago){<option value="@kv.Key">@kv.Value</option>}
    </select></div>
    <div class="col-12"><label class="form-label small">Uso CFDI</label>
    <select class="form-select" @onchange="e=>usoCfdi=e.Value!.ToString()!">
    @foreach(var kv in catalogos.UsosCfdi){<option value="@kv.Key">@kv.Value</option>}
    </select></div>
    <div class="col-12"><label class="form-label small">Cliente</label>
    <select class="form-select" @bind="clienteId" @bind:after="OnClienteCambiado">
    @foreach(var c in clientes){<option value="@c.Id">@c.Nombre</option>}
    </select>
    @if (creditoCliente is not null)
    {
        <span class="@(creditoCliente.EstaBloqueado ? "bg-danger" : creditoCliente.TieneCredito ? "bg-info text-dark" : "bg-success") badge fs-6">
            @(creditoCliente.EstaBloqueado ? "⚠ CRÉDITO BLOQUEADO" : creditoCliente.TieneCredito ? $"Crédito: ${creditoCliente.LimiteCredito - creditoCliente.SaldoVencido:N2} / ${creditoCliente.LimiteCredito:N2}" : "Contado")
        </span>
    }</div>
    <div class="col-12"><label class="form-label small">Vendedor (crédito de la venta)</label>
    <select class="form-select" @bind="vendedorId">
    <option value="">Sin asignar (usuario de sesión)</option>
    @foreach(var v in vendedores){<option value="@v.Id">@v.Nombre</option>}
    </select></div>
</div>


<div class="fs-5">Subtotal: <strong>$@Subtotal.ToString("N2")</strong></div>
<div class="fs-5">IVA 16%: <strong>$@Iva.ToString("N2")</strong></div>
<div class="fs-3">Total: <strong class="text-success">$@Total.ToString("N2")</strong></div>
<button type="button" class="btn btn-success btn-lg w-100 mt-2" disabled="@(carrito.Count==0||procesando)" @onclick="Cobrar">Cobrar</button>
@if(ultimo is not null){<div class="alert alert-info mt-2">Folio <strong>@ultimo.FolioInterno</strong> - @ultimo.Estado<br/>
<a class="btn btn-sm btn-outline-primary mt-1" href="/ticket/@ultimo.FacturaId" target="_blank">Imprimir ticket 58mm</a></div>}
</div></div></div>
</div>
</div>
